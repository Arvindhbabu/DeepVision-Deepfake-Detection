# DeepVision AI Environment Configuration Template
# Copy this file to .env for local environment overrides

# Project Settings
DEEPVISION_ENV=development
DEEPVISION_SEED=42

# Hardware Acceleration
CUDA_VISIBLE_DEVICES=0
TORCH_NUM_THREADS=4

